{
  "name": "wisdom-school-desktop",
  "description": "Wisdom School Desktop application",
  "author": "Wisdom School",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:build": "npm run build && electron-builder --win portable --x64",
    "electron:build:portable": "npm run build && electron-builder --win portable --x64",
    "electron:release": "npm run electron:build:portable",
    "apk:build": "powershell -NoProfile -Command \"Set-Location -Path 'C:\\Users\\JJJ\\Desktop\\website\\android'; if (-not (Test-Path 'local.properties')) { Set-Content -Path 'local.properties' -Value 'sdk.dir=C:/Android/sdk' }; .\\gradlew.bat assembleRelease; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Set-Location -Path 'C:\\Users\\JJJ\\Desktop\\website'; New-Item -ItemType Directory -Force -Path 'public\\apk' | Out-Null; Copy-Item -Force 'android\\app\\build\\outputs\\apk\\release\\app-release.apk' 'public\\apk\\Wisdom_School_Essur_Release.apk'\"",
    "clean": "rimraf dist server.js out",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "esbuild": "^0.25.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.0.1"
  }
}
